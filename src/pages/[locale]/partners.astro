---
import Layout from '../../layouts/Layout.astro';
import FeaturedSponsorCard from '../../components/FeaturedSponsorCard.astro';
import TeamPartnerCard from '../../components/TeamPartnerCard.astro';
import SupporterCard from '../../components/SupporterCard.astro';
import { useTranslations, locales, type Locale } from '../../i18n/utils';

export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const { t } = useTranslations(locale as Locale);
---

<Layout locale={locale as Locale}>
  <main>
    <section class="top-title-section page-top-section">
      <h1>{t('partners.title')}</h1>
    </section>

    <section class="page-content">
      <div class="content-text">
        <p set:html={t('partners.description')} />
      </div>
    </section>

    <section class="sponsors-section">
      <div class="featured-grid">
        <FeaturedSponsorCard
          name="ABC Tools"
          logo="/Sponsors/ABCTools.svg"
          url="https://www.abctools.it/"
          description={locale === 'it'
            ? "Dal 1913 ABC Tools è un punto di riferimento nell’utensileria professionale. Un catalogo di circa 30.000referenze in 12 sezioni unisce ampiezza di gamma, qualità e innovazione. Con il progetto “ABC Tools sostiene il talento”, l’azienda investe nelle nuove generazioni e nel futuro del lavoro."
            : "Since 1913, ABC Tools has been a benchmark in professional tooling. Its catalogue features around 30,000 SKUs across 12 categories, combining breadth of range, quality and innovation. Through “ABC Tools sostiene il talento”, the company invests in new generations and the future of work."}
          learnMoreLabel={t('partners.learnMore')}
        />

        <FeaturedSponsorCard
          name="+CIM"
          logo="/Sponsors/CIM.svg"
          url="https://cim.eu/"
          description={locale === 'it'
            ? "CIM è il centro di competenza dove l'innovazione nei campi della fabbricazione digitale e della fabbricazione additiva prende forma."
            : "CIM is the competence center where innovation in the fields of digital factory and additive manufacturing takes shape."}
          learnMoreLabel={t('partners.learnMore')}
        />
      </div>

      <div class="featured-grid">
        <FeaturedSponsorCard
          name="SIEMENS"
          logo="/Sponsors/SiemensLogo.svg"
          url="https://www.siemens.com"
          description={locale === 'it'
            ? "SIEMENS è un'azienda tecnologica globale che fornisce soluzioni innovative per vari settori industriali."
            : "SIEMENS is a global technology company that provides innovative solutions for various industries."}
          learnMoreLabel={t('partners.learnMore')}
        />
      </div>

      <div class="team-grid">
        <TeamPartnerCard
          name="3DZ"
          logo="/Sponsors/3DZ.svg"
          url="https://3dz.it/"
          description={locale === 'it'
            ? "3DZ opera nel campo della stampa 3D e della fabbricazione additiva da oltre 15 anni, servendo aziende, professionisti e privati."
            : "3DZ has been working with 3D printing and additive manufacturing technologies for over 15 years, serving companies, professionals, and individuals."}
        />

        <TeamPartnerCard
          name="Altium"
          logo="/Sponsors/Altium.svg"
          url="https://www.altium.com/"
          description={locale === 'it'
            ? "Altium è un fornitore leader di software e servizi per l'automazione dell'elettronica (EDA)."
            : "Altium is a leading provider of electronic design automation (EDA) software and services."}
        />

        <TeamPartnerCard
          name="Camloc"
          logo="/Sponsors/Camloc.svg"
          url="https://www.hfsindustrial.com/brands/camloc.html"
          description={locale === 'it'
            ? "Camloc è un produttore leader di fissaggi meccanici e componenti ad alte prestazioni."
            : "Camloc is a leading manufacturer of high-performance mechanical fasteners and components."}
        />

        <TeamPartnerCard
          name="Carbon-Ti"
          logo="/Sponsors/Carbon-Ti.svg"
          url="https://www.carbon-ti.it/"
          description={locale === 'it'
            ? "Cura artigianale, alta qualità, materiali tecnologici, tutti al 100% Made in Italy."
            : "Artisan care, high quality, technological materials all 100% Made in Italy."}
        />

        <TeamPartnerCard
          name="Easy Composites"
          logo="/Sponsors/EasyComposites.svg"
          url="https://www.easycomposites.eu/"
          description={locale === 'it'
            ? "Easy Composites Ltd è stata fondata nel 2010 e rapidamente è diventata leader globale nella produzione e fornitura di materiali compositi avanzati."
            : "Easy Composites Ltd was established in 2010 and grown quickly to become a global leader in the manufacture and supply of advanced composite materials and equipment."}
        />

        <TeamPartnerCard
          name="Erre Ti"
          logo="/Sponsors/ErreTi.svg"
          url="https://erreti.eu/"
          description={locale === 'it'
            ? "ErreTi Compositi è un produttore leader di materiali compositi avanzati e componenti."
            : "ErreTi Compositi is a leading manufacturer of advanced composite materials and components."}
        />

        <TeamPartnerCard
          name="Labo-System s.a.s."
          logo="/Sponsors/LaboSystem.svg"
          url="https://shop.labo-system.com/it/"
          description={locale === 'it'
            ? "Fondata a Torino nel 1988, Labo-System s.a.s. è un fornitore leader di strumentazione di prova e misurazione elettronica professionale."
            : "Established in Turin in 1988, Labo-System s.a.s. is a leading supplier of professional electronic testing and measurement instrumentation."}
        />

        <TeamPartnerCard
          name="Lyra Bearing"
          logo="/Sponsors/LyraBearing.svg"
          url="https://lyrabearing.com/"
          description={locale === 'it'
            ? "Progettiamo cuscinetti di precisione per offrire prestazioni superiori e migliorare l'efficienza in vari settori."
            : "We design precision bearings to deliver superior performance and boost efficiency across industries."}
        />

        <TeamPartnerCard
          name="Mouser"
          logo="/Sponsors/Mouser.svg"
          url="https://eu.mouser.com/en/educationalsales/"
          description={locale === 'it'
            ? "Mouser è un distributore globale leader di componenti elettronici, punto di riferimento per ingegneri e progettisti."
            : "Mouser is a leading global distributor of electronic components, being a reference point for engineers and electronics designers."}
        />

        <TeamPartnerCard
          name="Oakley"
          logo="/Sponsors/Oakley.svg"
          url="https://www.oakley.com/"
          description={locale === 'it'
            ? "Oakley è un produttore leader di occhiali e attrezzature sportive."
            : "Oakley is a leading manufacturer of eyewear and sports equipment."}
        />

        <TeamPartnerCard
          name="Pella Sportwear"
          logo="/Sponsors/Pella.svg"
          url="https://pellasportswear.com"
          description={locale === 'it'
            ? "Pella Sportwear è un produttore italiano di abbigliamento ciclistico."
            : "Pella Sportwear is an Italian manufacturer of cycling apparel."}
        />

        <TeamPartnerCard
          name="PhoenixPCB"
          logo="/Sponsors/PhoenixPCB.svg"
          url="https://www.phoenixpcb.com/"
          description={locale === 'it'
            ? "PhoenixPCB è un fornitore di circuiti stampati (PCB) di alta qualità."
            : "PhoenixPCB is a provider of high-quality printed circuit boards (PCBs)."}
        />

        <TeamPartnerCard
          name="Sabelt"
          logo="/Sponsors/Sabelt.svg"
          url="https://www.sabelt.com/"
          description={locale === 'it'
            ? "Sabelt è un leader nel settore delle cinture di sicurezza."
            : "Sabelt is a industry leader in safety harnesses."}
        />

        <TeamPartnerCard
          name="SmartCAE / Anaglyph"
          logo="/Sponsors/SmartCAE.svg"
          url="https://www.smartcae.com/"
          description={locale === 'it'
            ? "SmartCAE e Anaglyph, supportano il Team tramite il software Laminate Tools, utile per analisi strutturali e la stesura di ply-book."
            : "SmartCAE and Anaglyph support the team by providing the Laminate Tools software, useful for structural analysis and ply-book creation."}
        />
      </div>

      <h2>{t('partners.supporters')}</h2>
      <div class="supporters-grid">
        <SupporterCard
          logo="/Sponsors/igus.svg"
          url="https://www.igus.com/"
        />

        <SupporterCard
          logo="/Sponsors/Molex.svg"
          url="https://www.molex.com/"
        />

        <SupporterCard
          logo="/Sponsors/RedBull.svg"
          url="https://www.redbull.com/"
        />
      </div>
    </section>
  </main>
</Layout>

<style>
  .page-top-section {
    padding-top: 100px;
  }

  .sponsors-section {
    border-top: 3px solid #000000;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 30px 30px;
    background-color: #252525;
  }

  .sponsors-section h2 {
    padding-top: 10px;
    letter-spacing: -3px;
  }

  .featured-grid {
    display: flex;
    flex-direction: column;
    gap: 30px;
    padding: 30px 0;
  }

  .team-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    padding: 30px 0;
  }

  .supporters-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    padding: 30px 0;
    align-items: center;
  }

  @media (min-width: 640px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .supporters-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .team-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .supporters-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 1440px) {
    .team-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .supporters-grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }
</style>
