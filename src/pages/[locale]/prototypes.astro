---
import { getCollection } from 'astro:content';
import PrototypeCard from '../../components/PrototypeCard.astro';
import Layout from '../../layouts/Layout.astro';
import { useTranslations, locales, type Locale } from '../../i18n/utils';

export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const { t } = useTranslations(locale as Locale);

const prototypes = (await getCollection('prototypes'))
  .filter((entry) => entry.data.locale === locale)
  .sort((a, b) => b.data.order - a.data.order);
---

<Layout locale={locale as Locale}>
  <main>
    <section class="top-title-section">
      <img src="/TaurusX_Nevada.jpg" alt="TaurusX during the World Human Powered Speed Challenge in Nevada"/>
      <h1>{t('prototypes.title')}</h1>
    </section>

    <section class="page-content">
      <p class="prototypes-description">{t('prototypes.description')}</p>
    </section>

    <section class="prototypes-section">
      {
        prototypes.map((prototype) => (
          <PrototypeCard
            image={prototype.data.cardImage}
            name={prototype.data.title}
            years={prototype.data.season}
            category={prototype.data.category}
            link={`/${locale}/prototypes/${prototype.data.slug}`}
            yearsLabel={t('prototypes.season')}
            learnMoreLabel={t('prototypes.learnMore')}
          />
        ))
      }
    </section>
  </main>
</Layout>

<style>
  .prototypes-description {
    max-width: 1200px;
    margin: 0 auto;
    font-size: 18px;
    line-height: 1.8;
  }

  .prototypes-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding: 4rem 0;
    background-color: #252525;
  }
</style>
