---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { useTranslations, locales, type Locale } from '../../i18n/utils';

export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const { t } = useTranslations(locale as Locale);

const blogEntries = (await getCollection('blog')).filter(e => e.data.locale === locale);
blogEntries.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout locale={locale as Locale}>
  <main>
    <section class="top-title-section page-top-section">
      <h1>{t('blog.title')}</h1>
    </section>

    <section class="blog-section">
      {
        blogEntries.map(entry => {
          const slug = entry.id;
          return (
            <a href={`/${locale}/blog/${slug}`} class="blog-card-link">
              <div class="blog-card">
                {
                  entry.data.image && (
                    <div class="image-container">
                      <img src={entry.data.image} alt={entry.data.title} />
                    </div>
                  )
                }
                <div class="content">
                  <p class="date">{entry.data.pubDate.toLocaleDateString(locale === 'it' ? 'it-IT' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
                  <h2 class="title">{entry.data.shortTitle || entry.data.title}</h2>
                  <p class="description">{entry.data.description}</p>
                </div>
              </div>
            </a>
          );
        })
      }
    </section>
  </main>
</Layout>

<style>
  .page-top-section {
    padding-top: 100px;
  }

  .blog-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding: 4rem 0;
    background-color: #252525;
  }

  .blog-card-link {
    text-decoration: none;
    display: block;
    width: 100%;
    max-width: 900px;
  }

  .blog-card {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    width: 100%;
    max-height: 250px;
    background: var(--bg-color);
    border: 5px solid var(--link-color);
    border-radius: 20px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    transition: opacity 0.2s ease;
  }

  .blog-card-link:hover .blog-card {
    opacity: 0.85;
  }

  .image-container {
    flex: 1;
    min-width: 0;
    height: auto;
    aspect-ratio: 1;
  }

  .image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0px;
  }

  .content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 2rem;
    color: var(--text-color);
  }

  .date {
    margin: 0 0 0.5rem 0;
    color: var(--link-color);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .title {
    margin: 0 0 0.75rem 0;
    font-weight: bold;
    color: var(--text-color);
    font-size: 28px;
    letter-spacing: -1px;
    line-height: 1.3;
  }

  .description {
    margin: 0;
    color: var(--text-color);
    font-size: 14px;
    line-height: 1.5;
    opacity: 0.8;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .blog-card {
      flex-direction: column;
      max-height: none;
    }

    .blog-card-link {
      max-width: 90%;
    }

    .image-container {
      aspect-ratio: 16 / 9;
    }

    .image-container img {
      border-bottom: 3px solid var(--btn-color);
    }

    .content {
      padding: 1.5rem;
      justify-content: flex-start;
    }

    .title {
      font-size: 22px;
    }
  }
</style>
