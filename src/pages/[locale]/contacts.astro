---
import Layout from '../../layouts/Layout.astro';
import { useTranslations, locales, type Locale } from '../../i18n/utils';

export async function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const { t } = useTranslations(locale as Locale);
---

<Layout locale={locale as Locale}>
  <main>
    <section class="page-content contacts-content">
      <div class="contacts-text">
        <h1>{t('contacts.title')}</h1>
      </div>

      <section class="contacts-grid">
        <div class="contact-card">
          <div class="content">
            <p class="division-tag">{t('contacts.divisions.generic')}</p>
            <h2 class="division-name">Team Policumbent</h2>
            <a href="mailto:info@policumbent.it" class="contact-email">info@policumbent.it</a>
          </div>
        </div>

        <div class="contact-card">
          <div class="content">
            <p class="division-tag">{t('contacts.divisions.teamLeader')}</p>
            <h2 class="division-name">Mario Tarantino</h2>
            <a href="mailto:teamleader@policumbent.it" class="contact-email">teamleader@policumbent.it</a>
          </div>
        </div>

        <div class="contact-card">
          <div class="content">
            <p class="division-tag">{t('contacts.divisions.logistics')}</p>
            <h2 class="division-name">Logistics &amp; Supply Chain</h2>
            <a href="mailto:management@policumbent.it" class="contact-email">management@policumbent.it</a>
          </div>
        </div>

        <div class="contact-card">
          <div class="content">
            <p class="division-tag">{t('contacts.divisions.prMedia')}</p>
            <h2 class="division-name">PR &amp; Media</h2>
            <a href="mailto:communication@policumbent.it" class="contact-email">communication@policumbent.it</a>
          </div>
        </div>
    </section>
    </section>
  </main>
</Layout>

<style>
  .contacts-text {
    max-width: 900px;
    margin: 0 auto;
  }

  .contacts-text h1 {
    padding-top: 60px;
    margin: 0 auto 3rem 0;
  }

  .contacts-description {
    max-width: 900px;
    margin: 0 auto 3rem;
    font-size: 18px;
    line-height: 1.8;
  }

  .contacts-grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    background-color: #252525;
  }

  .contact-card {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    width: 100%;
    max-width: 900px;
    background: var(--bg-color);
    border: 5px solid var(--link-color);
    border-radius: 20px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    transition: opacity 0.2s ease;
  }

  .contact-card:hover {
    opacity: 0.85;
  }

  .content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 2rem;
    color: var(--text-color);
  }

  .division-tag {
    margin: 0 0 0.5rem 0;
    color: var(--link-color);
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .division-name {
    margin: 0 0 0.75rem 0;
    font-weight: bold;
    color: var(--text-color);
    font-size: 28px;
    letter-spacing: -1px;
    line-height: 1.3;
  }

  .contact-email {
    margin: 0;
    color: var(--text-color);
    font-size: 14px;
    line-height: 1.5;
    opacity: 0.8;
    text-decoration: underline;
    transition: color 0.3s ease;
  }

  .contact-email:hover {
    color: var(--link-color);
    opacity: 1;
  }

  @media (max-width: 768px) {
    .contact-card {
      max-width: 90%;
    }

    .content {
      padding: 1.5rem;
      justify-content: flex-start;
    }

    .division-tag {
      font-size: 12px;
    }

    .division-name {
      font-size: 22px;
    }

    .contact-email {
      font-size: 14px;
    }
  }
</style>
