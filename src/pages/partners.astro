---
import Layout from '../layouts/Layout.astro';
import FeaturedSponsorCard from '../components/FeaturedSponsorCard.astro';
import TeamPartnerCard from '../components/TeamPartnerCard.astro';
import SupporterCard from '../components/SupporterCard.astro';
---

<Layout>
  <main>
    <section class="top-title-section page-top-section">
      <h1>Partners & Sponsors</h1>
    </section>

    <section class="page-content">
      <div class="content-text">
        <p>
          We are proud to collaborate with leading companies and institutions that support our mission
          to push the limits of human-powered speed. Their contribution is essential to the
          success of <em>Policumbent</em>.
        </p>
      </div>
    </section>

    <section class="sponsors-section">
      <div class="featured-grid">
        <FeaturedSponsorCard
          name="ABC Tools"
          logo="/Sponsors/ABCTools.png"
          url="https://www.abctools.it/"
          description="ABC Tools is a leading provider of innovative tools and
          solutions for various industries. "
        />

        <FeaturedSponsorCard
          name="+CIM"
          logo="/Sponsors/CIM.svg"
          url="https://cim.eu/"
          description="CIM is the competence center where innovation in the
          fields of digital factory and additive manufacturing takes shape."
        />
      </div>

      <div class="featured-grid">
        <FeaturedSponsorCard
          name="SIEMENS"
          logo="/Sponsors/SiemensLogo.svg"
          url="https://www.siemens.com"
          description="SIEMENS is a global technology company that provides
          innovative solutions for various industries."
        />
      </div>

      <div class="team-grid">
        <TeamPartnerCard
          name="3DZ"
          logo="/Sponsors/3DZ.svg"
          url="https://3dz.it/"
          description="3DZ has been working with 3D printing and additive
          manufacturing technologies for over 15 years, serving companies,
          professionals, and individuals."
        />

        <TeamPartnerCard
          name="Altium"
          logo="/Sponsors/Altium.svg"
          url="https://www.altium.com/"
          description="Altium is a leading provider of electronic design
          automation (EDA) software and services."
        />

        <TeamPartnerCard
          name="Camloc"
          logo="/Sponsors/Camloc.svg"
          url="https://www.hfsindustrial.com/brands/camloc.html?__cf_chl_f_tk=iHvaCf2V3C4lYZ9_LhA8MizwPMO6x6zHEkaSjRSjUJI-1782845414-1.0.1.1-0fiDlKlGznvbrqfzKx14a8adDOY0XEhXrJW7G9nqvJY"
          description="Camloc is a leading manufacturer of high-performance
          mechanical fasteners and components."
        />

        <TeamPartnerCard
          name="Carbon-Ti"
          logo="/Sponsors/Carbon-Ti.svg"
          url="https://www.carbon-ti.it/"
          description="Artisan care, high quality, technological materials all
          100% Made in Italy. These are the strengths that make Carbon-Ti the
          Italian brand of reference in the field of premium quality bike
          components, accessories and spare parts manufacturing."
        />

        <TeamPartnerCard
          name="Easy Composites"
          logo="/Sponsors/EasyComposites.svg"
          url="https://www.easycomposites.eu/"
          description="Easy Composites Ltd was established in 2010 and grown
          quickly to become a global leader in the manufacture and supply of
          advanced composite materials and equipment."
        />

        <TeamPartnerCard
          name="Erre Ti"
          logo="/Sponsors/ErreTi.svg"
          url="https://erreti.eu/"
          description="ErreTi Compositi is a leading manufacturer of advanced composite materials and components."
        />

        <TeamPartnerCard
          name="Labo-System s.a.s."
          logo="/Sponsors/LaboSystem.svg"
          url="https://shop.labo-system.com/it/"
          description="Established in Turin in 1988, Labo-System s.a.s. is a
          leading supplier of professional electronic testing and measurement
          instrumentation, serving both the Italian and international markets."
        />

        <TeamPartnerCard
          name="Lyra Bearing"
          logo="/Sponsors/LyraBearing.svg"
          url="https://lyrabearing.com/"
          description="We design precision bearings to deliver superior
          performance and boost efficiency across industries"
        />

        <TeamPartnerCard
          name="Mouser Electronics"
          logo="/Sponsors/MouserElectronics.svg"
          url="https://www.mouser.com/"
          description="Mouser Electronics is a leading global distributor of
          electronic components, being a reference point for engineers and
          electronics designers."
        />

        <TeamPartnerCard
          name="Oakley"
          logo="/Sponsors/Oakley.svg"
          url="https://www.oakley.com/"
          description="Oakley is a leading manufacturer of eyewear and sports equipment."
        />

        <TeamPartnerCard
          name="Pella Sportwear"
          logo="/Sponsors/Pella.svg"
          url="https://pellasportswear.com"
          description="Pella Sportwear is an Italian manufacturer of cycling apparel."
        />

        <TeamPartnerCard
          name="PhoenixPCB"
          logo="/Sponsors/PhoenixPCB.svg"
          url="https://www.phoenixpcb.com/"
          description="PhoenixPCB is a provider of high-quality printed circuit boards (PCBs)."
        />

        <TeamPartnerCard
          name="Sabelt"
          logo="/Sponsors/Sabelt.svg"
          url="https://www.sabelt.com/"
          description="Sabelt is a industry leader in safety harnesses."
        />
      </div>

      <h2>Supporters</h2>
      <div class="supporters-grid">
        <SupporterCard
          logo="/Sponsors/igus.svg"
          url="https://www.igus.com/"
        />

        <SupporterCard
          logo="/Sponsors/Molex.svg"
          url="https://www.molex.com/"
        />

        <SupporterCard
          logo="/Sponsors/RedBull.svg"
          url="https://www.redbull.com/"
        />
      </div>
    </section>
  </main>
</Layout>

<style>
  .page-top-section {
    padding-top: 100px;
  }

  .sponsors-section {
    border-top: 3px solid #000000;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 30px 30px;
    background-color: #252525;
  }

  .sponsors-section h2 {
    padding-top: 10px;
    letter-spacing: -3px;
  }

  .featured-grid {
    display: flex;
    flex-direction: column;
    gap: 30px;
    padding: 30px 0;
  }

  .team-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    padding: 30px 0;
  }

  .supporters-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    padding: 30px 0;
    align-items: center;
  }

  @media (min-width: 640px) {
    .team-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .supporters-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .team-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .supporters-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 1440px) {
    .team-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .supporters-grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }
</style>
