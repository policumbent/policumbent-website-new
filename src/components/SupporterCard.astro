---
interface Props {
  logo: string;
  url: string;
  alt?: string;
}

const { logo, url, alt = "Supporter logo" } = Astro.props;
---

<a href={url} target="_blank" rel="noopener noreferrer" class="supporter-card">
  <img src={logo} alt={alt} loading="lazy" />
</a>

<style>
  .supporter-card {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    transition: opacity 0.3s ease;
  }

  .supporter-card:hover {
    opacity: 0.7;
  }

  .supporter-card img {
    width: 100%;
    height: auto;
    max-height: 80px;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  a { text-decoration: none; }
</style>
