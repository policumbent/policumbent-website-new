---
// Header.astro
import logo from '../assets/LogoPolicumbent_Wht.svg';
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = useTranslations(locale);
const currentPath = Astro.url.pathname;
const { otherLocale } = useTranslations(locale);

function getAlternateUrl(path: string, targetLocale: Locale): string {
  const segments = path.split('/').filter(Boolean);
  if (segments.length > 0 && (segments[0] === 'en' || segments[0] === 'it')) {
    segments[0] = targetLocale;
  } else {
    segments.unshift(targetLocale);
  }
  // Blog post slugs contain a locale suffix (e.g. ...-en or ...-it) that also needs swapping
  if (segments.length >= 3 && segments[1] === 'blog') {
    const slug = segments[segments.length - 1];
    const currentSuffix = locale === 'it' ? '-it' : '-en';
    const targetSuffix = targetLocale === 'it' ? '-it' : '-en';
    if (slug.endsWith(currentSuffix)) {
      segments[segments.length - 1] = slug.slice(0, -currentSuffix.length) + targetSuffix;
    }
  }
  return '/' + segments.join('/') + (path.endsWith('/') && segments.length > 1 ? '/' : '');
}

const switchUrl = getAlternateUrl(currentPath, otherLocale);
---

<header class="main-header">
  <div class="header-container">
    <a href={`/${locale}`} class="logo">
    <img class="logo" src={logo.src} height="40%" alt="Policumbent Logo" />
    </a>
    
    <div class="header-right">
      <a href={switchUrl} class="header-lang">{t('language.switchTo')}</a>

      <button class="hamburger" id="hamburger-btn" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
    
    <nav class="nav-links" id="nav-menu">
      <a href={`/${locale}/team`}>{t('nav.team')}</a>
      <a href={`/${locale}/blog`}>{t('nav.blog')}</a>
      <a href={`/${locale}/prototypes`}>{t('nav.prototypes')}</a>
      <a href={`/${locale}/competitions`}>{t('nav.competitions')}</a>
      <a href={`/${locale}/partners`}>{t('nav.partners')}</a>
      <a href={`/${locale}/contacts`} class="btn-contacts">{t('nav.contacts')}</a>
      <a href={switchUrl} class="lang-toggle">{t('language.switchTo')}</a>
    </nav>
  </div>
</header>

<script>
  const hamburgerBtn = document.getElementById('hamburger-btn');
  const navMenu = document.getElementById('nav-menu');

  if (hamburgerBtn && navMenu) {
    hamburgerBtn.addEventListener('click', () => {
      navMenu.classList.toggle('active');
      hamburgerBtn.classList.toggle('active');
    });

    const navLinks = navMenu.querySelectorAll('a');
    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        navMenu.classList.remove('active');
        hamburgerBtn.classList.remove('active');
      });
    });
  }
</script>

<style>
  .main-header {
    position: fixed;
    top: 15px;
    left: 25px;
    right: 25px;
    z-index: 1000;
    background-color: rgba(37, 37, 37, 0.6);
    border: 3px solid #000000;
    border-radius: 22px;
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    padding: 15px 30px;
    box-sizing: border-box;
    font-family: 'Inter var', sans-serif;
  }

  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0 auto;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .logo {
    height: 45px;
    width: auto;
    border-radius: 0;
  }

  .logo img {
    height: 45px;
    width: auto;
  }

  .nav-links {
    display: flex;
    gap: 30px;
    align-items: center;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 6px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .hamburger span {
    width: 25px;
    height: 3px;
    background-color: var(--text-color);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .header-lang {
    display: none;
    text-decoration: none;
    color: var(--text-color);
    font-weight: 600;
    font-size: 14px;
    padding: 4px 10px;
    border: 2px solid var(--text-color);
    border-radius: 5px;
    text-transform: uppercase;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .header-lang:hover {
    background-color: var(--text-color);
    color: #252525;
  }

  .nav-links a:not(.btn-contacts):not(.lang-toggle) {
    text-decoration: none;
    color: var(--text-color);
    font-weight: 500;
    font-size: 16px;
    text-transform: uppercase;
    position: relative;
    transition: color 0.3s ease;
  }

  .nav-links a:not(.btn-contacts):not(.lang-toggle)::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--text-color);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }

  .nav-links a:not(.lang-toggle):hover {
    color: var(--text-color);
  }

  .nav-links a:not(.btn-contacts):not(.lang-toggle):hover::after {
    transform: scaleX(1);
  }

  .btn-contacts {
    background-color: var(--btn-color);
    color: var(--btn-text);
    padding: 5px 20px;
    border-radius: 5px;
    text-decoration: none;
    font-weight: 500;
    text-transform: uppercase;
    font-size: 16px;
    transition: background-color 0.3s ease;
  }

  .btn-contacts:hover {
    background-color: #000000;
    color: var(--btn-text);
  }

  .lang-toggle {
    text-decoration: none;
    color: var(--text-color);
    font-weight: 600;
    font-size: 14px;
    padding: 4px 10px;
    border: 2px solid var(--text-color);
    border-radius: 5px;
    text-transform: uppercase;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .lang-toggle:hover {
    background-color: var(--text-color);
    color: #252525;
  }

  /* Desktop */
  @media (min-width: 920px) {
    .hamburger {
      display: none !important;
    }
    .nav-links {
      display: flex !important;
    }
  }

  /* Mobile */
  @media (max-width: 920px) {
    .main-header {
      min-height: 65px;
      top: 10px;
      left: 10px;
      right: 10px;
      padding: 10px 20px;
      border-radius: 15px;
      border: 2px solid #000000;
      position: fixed;
    }

    .header-container {
      position: relative;
    }

    .logo {
      padding: 1px 0px;
      height: 40px;
      vertical-align: center;
    }

    .logo img {
      height: 40px;
    }

    .hamburger {
      display: flex;
    }

    .header-lang {
      display: inline-block;
    }

    .hamburger.active span:nth-child(1) {
      transform: rotate(45deg) translateY(13px);
    }

    .hamburger.active span:nth-child(2) {
      opacity: 0;
    }

    .hamburger.active span:nth-child(3) {
      transform: rotate(-45deg) translateY(-13px);
    }

    .nav-links {
      position: fixed;
      top: calc(10px + 10px + 20px + 1.5rem + 17px);
      left: -1px;
      right: -1px;
      flex-direction: column;
      gap: 0;
      background-color: #252525ee;
      -webkit-backdrop-filter: blur(20px);
      backdrop-filter: blur(20px);
      border: 2px solid #000000;
      border-radius: 15px;
      padding: 15px;
      display: none;
      animation: slideDown 0.3s ease-out forwards;
      z-index: 999;
      box-sizing: border-box;
    }

    .nav-links.active {
      display: flex;
    }

    @keyframes slideDown {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .nav-links a {
      padding: 15px 20px;
      border-bottom: 1px solid rgba(244, 247, 237, 0.1);
      display: block;
    }

    .nav-links a:last-of-type {
      border-bottom: none;
    }

    .nav-links a:not(.btn-contacts):not(.lang-toggle) {
      font-size: 14px;
      padding: 15px 20px !important;
    }

    .btn-contacts {
      font-size: 14px;
      padding: 10px 20px !important;
      display: block;
      text-align: center;
      background-color: var(--btn-color);
      margin: 0;
      border-radius: 5px;
      margin-top: 17px;
    }

    .lang-toggle {
      display: none !important;
    }
  }
</style>
