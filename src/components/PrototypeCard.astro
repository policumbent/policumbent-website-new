---
interface Props {
  image: string;
  name: string;
  years: string;
  category: string;
  link: string;
  yearsLabel?: string;
  learnMoreLabel?: string;
}

const { image, name, years, category, link, yearsLabel = 'Years of activity:', learnMoreLabel = 'Learn more &#8599;' } = Astro.props;
---

<a href={link} class="prototype-card-link">
  <div class="prototype-card">
    <div class="image-container">
      <img src={image} alt={name} loading="lazy" />
    </div>
    <div class="content">
      <p class="season">{yearsLabel} {years}</p>
      <h3 class="name">{name}</h3>
      <p class="category">{category}</p>
      <p class="link" set:html={learnMoreLabel} />
    </div>
  </div>
</a>

<style>
  .prototype-card-link {
    text-decoration: none;
    display: block;
    width: 100%;
    max-width: 900px;
  }

  .prototype-card {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    width: 100%;
    max-height: 250px;
    background: var(--bg-color);
    border: 5px solid var(--link-color);
    border-radius: 20px;
    overflow: hidden;
    transition: opacity 0.2s ease;
  }

  .prototype-card-link:hover .prototype-card {
    opacity: 0.85;
  }

  .image-container {
    flex: 1;
    min-width: 0;
    height: auto;
    aspect-ratio: 1;
  }

  .image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  .content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 2rem;
    color: var(--text-color);
  }

  .season {
    margin: 0 0 0.5rem 0;
    color: var(--link-color);
    font-weight: 500;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .name {
    margin: 0 0 0.75rem 0;
    font-weight: bold;
    color: var(--text-color);
    font-size: 28px;
    letter-spacing: -1px;
    line-height: 1.3;
  }

  .category {
    margin: 0;
    color: var(--text-color);
    font-size: 14px;
    line-height: 1.5;
    opacity: 0.8;
  }

  .link {
    margin: 12px 0 0 0;
    color: var(--link-color);
    font-size: 14px;
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .prototype-card {
      flex-direction: column;
      max-height: none;
    }

    .prototype-card-link {
      max-width: 90%;
    }

    .image-container {
      aspect-ratio: 16 / 9;
    }

    .image-container img {
      border-bottom: 3px solid var(--btn-color);
    }

    .content {
      padding: 1.5rem;
      justify-content: flex-start;
    }

    .name {
      font-size: 22px;
    }
  }
</style>
